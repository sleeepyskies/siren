assets:
  path: "../assets"   # relative to working directory
  # todo: hot-reload

window:
  title: "siren"
  width: 1280
  height: 720
  fullscreen: false
  vsync: true
  decorated: true
  resizable: true
  transparent: true

renderer:
  backend: "auto"       # can be "auto" | "opengl"

logging:
  level: "trace"        # can be "trace" | "debug" | "info" | "warn" | "err" | "critical" | "off"
  console: true
  file-path: "../tmp/siren.log"
